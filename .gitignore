# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
# 上面那条 `/build/` 只匹配仓库根；AGP 8.11 起 Gradle 还会在 android/ 下
# 单独生成一个 build/，不加这行的话每次 APK 构建后它都会冒出来。
/android/build/

# Git worktrees
.worktrees/
# Release signing key — do not commit
# 所有 keystore 变体一律不进 git（含改名前的备份 .bak）
android/app/*.keystore
android/app/*.keystore.*
android/app/*.jks
android/key.properties

# AQT native build artifacts
ios/Frameworks/AqtClientFfi.xcframework
rust/aqt_client_ffi/include/aqt_client_ffi.h

# iOS 打包产物（未签名 IPA）
ipa-out/

# FlyTerm Server assets — generated by scripts/build-server-assets.sh, do not commit.
assets/flyterm-server/flyterm-server-linux-*
assets/flyterm-server/VERSION

# Agent tooling scratch space. `.claude/` holds worktrees and grows to
# multiple GB; `.codegraph/` is a regenerable index. Neither belongs in git —
# without these lines a single `git add -A` would commit ~3.5 GB.
.claude/
.codegraph/
.superpowers/

# Rust cdylib，由 Gradle 的 buildAqtClientFfi（cargo-ndk）生成。
# 不进 git —— 公开仓库里放一个无法与源码比对的预编译二进制是信任负担，
# 且会导致源码/二进制静默漂移。同目录的 .gitkeep 保留，目录要在。
android/app/src/main/jniLibs/**/*.so
